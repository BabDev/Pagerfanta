{
    "name": "pagerfanta/twig",
    "type": "library",
    "description": "Twig integration for Pagerfanta",
    "keywords": ["pagerfanta"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "pagerfanta/core": "^4.7 || ^5.0",
        "twig/twig": "^3.12"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.4"
    },
    "autoload": {
        "psr-4": {
            "Pagerfanta\\Twig\\": "./"
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "minimum-stability": "dev"
}
