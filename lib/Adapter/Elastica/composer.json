{
    "name": "pagerfanta/elastica-adapter",
    "type": "library",
    "description": "Pagerfanta adapter for Elastica",
    "keywords": ["pagerfanta", "elastica"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "pagerfanta/core": "^4.7 || ^5.0",
        "ruflin/elastica": "^7.3 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Pagerfanta\\Elastica\\": "./"
        },
        "exclude-from-classmap": [
            "Tests/"
        ]
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "minimum-stability": "dev"
}
